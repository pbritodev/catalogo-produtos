option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: catalogo.wsgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: catalogo.settings
  # WhiteNoise cuida dos estáticos; sem o mapping nginx abaixo, evita conflito.
  # aws:elasticbeanstalk:environment:proxy:staticfiles:
  #   /static: staticfiles

container_commands:
  01_migrate:
    command: "source $PYTHONPATH/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source $PYTHONPATH/activate && python manage.py collectstatic --noinput"
  03_criar_superuser:
    command: "source $PYTHONPATH/activate && python manage.py criar_superuser"
    leader_only: true
