# ════════════════════════════════════════════════════════════════
# Copie este arquivo para ".env" e preencha os valores.
# Variáveis em branco ou ausentes mantêm o modo local (SQLite + disco).
# ════════════════════════════════════════════════════════════════

# ── Django ──────────────────────────────────────────────────────
# Em produção use uma chave aleatória e DEBUG=False
# DJANGO_SECRET_KEY=troque-isto-por-uma-chave-aleatoria-longa
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=meusite.com,www.meusite.com

# ── Banco: Amazon RDS PostgreSQL ────────────────────────────────
# Enquanto DB_HOST estiver vazio/ausente, usa SQLite local.
DB_NAME=voltstore
DB_USER=postgres
DB_PASSWORD=suaSenhaForteAqui
DB_HOST=meu-banco.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_SSLMODE=require       # require | verify-full | disable
DB_CONN_MAX_AGE=60

# ── Mídia: AWS S3 ───────────────────────────────────────────────
# Enquanto USE_S3 não for "True", as imagens ficam no disco local.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=voltstore-midia
AWS_S3_REGION_NAME=us-east-1

# Credenciais (NÃO precisa preencher se rodar em EC2/EB com IAM Role):
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Opcional: domínio customizado/CDN para servir as imagens
# AWS_S3_CUSTOM_DOMAIN=cdn.meusite.com
